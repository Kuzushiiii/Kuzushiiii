name: Update Activity Graph

on:
  schedule:
    - cron: "0 0 * * *" # Otomatis update setiap tengah malam
  workflow_dispatch: # Bisa di-trigger manual

jobs:
  build:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
      
      - name: Generate activity graph
        uses: maurodesouza/github-readme-activity-graph-action@v1
        with:
          username: Kuzushiii
          theme: github-dark 
          line: 238636 # Hex code untuk warna hijau GitHub
